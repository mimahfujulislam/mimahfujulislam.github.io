# Public URL of the deployed site (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://mimahfujulislam.github.io

# Only when served from a sub-path, e.g. https://mimahfujulislam.github.io/portfolio → /portfolio
NEXT_PUBLIC_BASE_PATH=

# Optional form endpoint (e.g. https://formspree.io/f/xxxx). Empty = the form opens the visitor's email app.
NEXT_PUBLIC_CONTACT_ENDPOINT=
